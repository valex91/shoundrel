#!/usr/bin/env bash

ESCAPE_SEQ='\e['

_rules=(
  'Deck'
  '- Clubs & Spades (1–14): Monsters — damage = value'
  '- Diamonds (1–9): Weapons — damage = value, must equip on pickup, replaces previous'
  '- Hearts (1–9): Potions — heal = value, max HP 20, only 1 per turn'

  'Turn (e to pick)'
  '- Room always has 4 cards, you must pick 3 (1 carries over to next room)'
  '- Weapon: auto-equip, discard old weapon + its monsters'
  '- Potion: heal up to 20, second potion in same turn is discarded with no effect'
  '- Monster: take full damage barehanded, OR use weapon → damage = monster - weapon (min 0)'
   ' - After using weapon on a monster, weapon can only fight monsters of strictly lower value than the last one it'
  'killed'

  'Skip room (n)'
  '- Scoop all 4 cards to bottom of dungeon'
  '- Cannot skip two rooms in a row'

  'End conditions'
  '- HP ≤ 0 → lose'
  '- Deck empty → win'
 )

interpolate() {
	local command=$1
	printf '%b' "$ESCAPE_SEQ$command"
}

showCursor() {
	interpolate '?25h'	
}

hideCursor() {
	interpolate '?25l'
}

gotoTab() {
	interpolate '?1049h'
}

returnTab() {
	interpolate '?1049l'
}

getSize() {
  declare -n _rowsRef=$1
  declare -n _columnsRef=$2

  read -r _rowsRef _columnsRef < <(stty size)
}

clearScreen() {
  interpolate '2J'	
}

moveCursor() {
 local x=${1:-0}
 local y=${2:-0}

 interpolate "$x;${y}H"
}

drawInverted() {
 local content=$1
 printf '\e[7m%b\e[0m' "$content"
}


drawTitle() {
  local startingRow=${1:-0}
  local startingCol=${2:-0}

  titleRows=(
    '  ____  _                           _          _  ' \
    ' / ___|| |__   ___  _   _ _ __   __| |_ __ ___| | ' \
    " \___ \| '_ \ / _ \| | | | '_ \ / _\` | '__/ _ \ | " \
    '  ___) | | | | (_) | |_| | | | | (_| | | |  __/ | ' \
    ' |____/|_| |_|\___/ \__,_|_| |_|\__,_|_|  \___|_| '
  )


  local _toPlay="press P to play"
  drawAtPosition "$startingRow" "$startingCol" titleRows 
  local titleHeight=${#titleRows[@]}
  moveCursor $(($startingRow+$titleHeight)) 0
  printf "$_toPlay"
  drawAtPosition $(($startingRow+$titleHeight+1)) 0  _rules

}

writeAtPosition() {
    local startingRow=${1:-0}
    local startingCol=${2:-0}
    local toPrint=$3
    local isInverted=$4

    moveCursor "$startingRow" "$startingCol"
    
    if [[ $isInverted == true ]]; then
      drawInverted "$toPrint"
    else
      printf '%b' "$toPrint"
    fi  
}
