#!/usr/bin/env bash

ESCAPE_SEQ='\e['

drawStats() {
  local hp=$1
  local weapon=$2
  local lastSlayed=$3

  local heart=$'\u2665'
  local cross=$'\u271D'
  local fist=$'\u270B'
  local sword=$'\u2694'

  local weaponIcon="$fist"
  if (( weapon > 0 )); then
    weaponIcon="$sword"
  fi

  local lastLine="│               │"
  if (( lastSlayed > 0 )); then
    lastLine="│ $cross Last: $lastSlayed       │"
  fi

  local hpStr="│ $heart HP:  $hp"
  local wpnStr="│ $weaponIcon Wpn: $weapon"
  # pad to fixed width so closing │ lines up at col 17
  while (( ${#hpStr} < 16 )); do hpStr="$hpStr "; done
  while (( ${#wpnStr} < 16 )); do wpnStr="$wpnStr "; done

  local _statPanel=(
    "╭───────────────╮"
    "$hpStr│"
    "$wpnStr│"
    "$lastLine"
    "╰───────────────╯"
  )
  drawAtPosition 1 1 _statPanel
}

printBold() {
 local content=$1
 printf '\e[1m%b\e[0m' "$content"
}

titleRows=(
  '  ____  _                           _          _  ' \
  ' / ___|| |__   ___  _   _ _ __   __| |_ __ ___| | ' \
  " \___ \| '_ \ / _ \| | | | '_ \ / _\` | '__/ _ \ | " \
  '  ___) | | | | (_) | |_| | | | | (_| | | |  __/ | ' \
  ' |____/|_| |_|\___/ \__,_|_| |_|\__,_|_|  \___|_| '
)

_rules=(
  "$(printBold 'Controls')"
  '  [a/d] Navigate    [e] Pick card    [n] Skip room'
  ''
  "$(printBold 'Cards')"
  '  ♠♣  Monster  — take damage equal to value'
  '  ♦   Weapon   — equip on pickup, replaces previous'
  '  ♥   Potion   — heal by value (max 20, once per turn)'
  ''
  "$(printBold 'Combat')"
  '  Barehanded  — full monster damage'
  '  With weapon — damage = monster − weapon (min 0)'
  '  Used weapon can only fight weaker monsters after first kill'
  ''
  "$(printBold 'Room')"
  '  Pick 3 of 4 cards — 1 carries over to next room'
  '  Cannot skip two rooms in a row'

  "$(printBold 'End conditions')"
  '- HP ≤ 0 → lose'
  '- Deck empty → win'
 )

interpolate() {
	local command=$1
	printf '%b' "$ESCAPE_SEQ$command"
}

showCursor() {
	interpolate '?25h'	
}

hideCursor() {
	interpolate '?25l'
}

gotoTab() {
	interpolate '?1049h'
}

returnTab() {
	interpolate '?1049l'
}

getSize() {
  declare -n _rowsRef=$1
  declare -n _columnsRef=$2

  read -r _rowsRef _columnsRef < <(stty size)
}

clearScreen() {
  interpolate '2J'	
}

moveCursor() {
 local x=${1:-0}
 local y=${2:-0}

 interpolate "$x;${y}H"
}

drawInverted() {
 local content=$1
 printf '\e[7m%b\e[0m' "$content"
}



writeAtPosition() {
    local startingRow=${1:-0}
    local startingCol=${2:-0}
    local toPrint=$3
    local isInverted=$4

    moveCursor "$startingRow" "$startingCol"
    
    if [[ $isInverted == true ]]; then
      drawInverted "$toPrint"
    else
      printf '%b' "$toPrint"
    fi  
}

getTitleAsciiHeight() {
  printf '%b' "${#titleRows[@]}"
}

getTitleAsciiLength() {
 printf '%b' "${#titleRows[0]}"
}

drawTitle() {
  local startingRow=${1:-0}
  local startingCol=${2:-0}
  local rulesLength=$(longestMember _rules)

  local _toPlay=$(printBold "▶  press P to play  ◀")
  local _toPlayL=${#_toPlay}
  drawAtPosition "$startingRow" "$startingCol" titleRows 
  local titleHeight=${#titleRows[@]}
  writeAtPosition $(($startingRow+$titleHeight + 3 )) $(( ($COLS / 2 )  - ($_toPlayL / 2))) "$_toPlay"
  drawAtPosition $(($startingRow+$titleHeight+4)) $((rulesLength / 2))  _rules
}

